# Copie para .env e preencha. O .env NAO vai para o git.

# ---------- banco ----------
# 5434 no host de proposito: 5432 e do stockflow/beacon e 5433 e do billing-platform.
DB_USER=crbap
DB_PASSWORD=troque-esta-senha
DB_PORT=5434

# ---------- redis (entra na fase 2) ----------
REDIS_PASSWORD=troque-esta-senha
REDIS_PORT=6380

# ---------- rabbitmq (entra na fase 6) ----------
RABBIT_USER=crbap
RABBIT_PASSWORD=troque-esta-senha
RABBIT_PORT=5673
RABBIT_MGMT_PORT=15673

# ---------- aplicacao ----------
# 8081 porque a 8080 e do billing-platform.
APP_PORT=8081

# ---------- fase 2: chaves e primeiro administrador ----------
# Sem ADMIN_INITIAL_PASSWORD (minimo 12 caracteres), NENHUM usuario e criado na
# primeira subida - e de proposito: sistema que sobe com admin/admin e como a
# maioria dos incidentes comeca. O usuario nasce obrigado a trocar a senha.
ADMIN_EMAIL=admin@crbap.local

# openssl genrsa -out private.pem 2048
# openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# openssl rand -base64 32
DATA_ENCRYPTION_KEY=
BLIND_INDEX_KEY=

# Senha do primeiro admin; o seed exige troca no primeiro login.
ADMIN_INITIAL_PASSWORD=

# ---------- fase 8: observabilidade ----------
GRAFANA_PASSWORD=troque-esta-senha
